# ─── APLICAÇÃO ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=False

# ─── ENTREGA DURÁVEL ──────────────────────────────────────────────
# Seguro por padrão: worker sobe, mantém heartbeat/manutenção, não faz claims.
DELIVERY_MODE=direct
DELIVERY_DISPATCH_ENABLED=false
DELIVERY_CUTOVER_EPOCH=
# Fundação de turns por inbox. Permanece desligada até rollout explícito;
# quando ligada, INBOX_SCHEDULER_EPOCH deve corresponder ao singleton no DB.
INBOX_SCHEDULER_ENABLED=false
INBOX_SCHEDULER_EPOCH=
# Processador de turns: desligado. Ticket 06 adicionou consumidores de handoff
# e delivery; quando ligado, ainda recusa start sem scheduler + ambos epochs.
INBOX_TURN_PROCESSOR_ENABLED=false
INBOX_TURN_PROCESSOR_CONCURRENCY=4
INBOX_TURN_LEASE_SECONDS=30
# Deve ser finito e menor que INBOX_TURN_LEASE_SECONDS / 3.
INBOX_TURN_POLL_INTERVAL_SECONDS=0.5
# Todos os valores float deste bloco rejeitam NaN e infinito.
INBOX_GENERATION_TIMEOUT_SECONDS=45
INBOX_TYPING_JITTER_MS=400
INBOX_TURN_RELEASE_BACKOFF_SECONDS=5
INBOX_TURN_WORKER_HEALTH_PATH=/tmp/turn-worker-health.json
DELIVERY_WORKER_CONCURRENCY=8
DELIVERY_CLAIM_MAX_ATTEMPTS=4
# Valores float rejeitam NaN e infinito.
DELIVERY_CLAIM_RETRY_JITTER_SECONDS=0.05
DELIVERY_POLL_INTERVAL_SECONDS=1
DELIVERY_LEASE_RENEW_INTERVAL_SECONDS=30
DELIVERY_EVOLUTION_LEASE_SECONDS=90
DELIVERY_CHATWOOT_LEASE_SECONDS=120
DELIVERY_EVOLUTION_DEADLINE_SECONDS=60
DELIVERY_CHATWOOT_DEADLINE_SECONDS=300
DELIVERY_TRANSITION_TTL_SECONDS=1800
DELIVERY_AUTOMATED_TTL_SECONDS=1800
DELIVERY_HUMAN_REPLY_TTL_SECONDS=86400
DELIVERY_HANDOFF_SETUP_TTL_SECONDS=86400
# F0-T5 turn-worker: real Compose grace40s, hard exit39.5s; drain30+abort5+accounting4.
# App: HTTP drain8s + cleanup 1.5s < explicit Compose grace 10s; hard exit9.5s.
DELIVERY_SHUTDOWN_GRACE_SECONDS=30
DELIVERY_SHUTDOWN_ABORT_SECONDS=5
DELIVERY_HEARTBEAT_INTERVAL_SECONDS=15
DELIVERY_READINESS_INTERVAL_SECONDS=60
DELIVERY_MAINTENANCE_INTERVAL_SECONDS=15
DELIVERY_MAINTENANCE_SKIP_ERROR_THRESHOLD=3
DELIVERY_RETENTION_INTERVAL_SECONDS=3600
# S1: budgets por passada; SLA = horizonte + tolerância (segundos)
SCHEDULER_RETENTION_MAX_ROWS=10000
# R2-S1: independent single-flight task; does not delay claim/heartbeat.
# DELIVERY_HEARTBEAT_INTERVAL_SECONDS + DELIVERY_POLL_INTERVAL_SECONDS < 60.
SCHEDULER_RETENTION_MAX_SECONDS=30
SCHEDULER_RETENTION_SLA_TOLERANCE_SECONDS=86400
# FU-1: finite margin; interval*N > budget+margin; sweep age+tolerance <7d.
DELIVERY_RETENTION_OVERRUN_MARGIN_SECONDS=30
DELIVERY_RETENTION_COMPLETION_MAX_INTERVALS=2
SCHEDULER_RETENTION_SWEEP_MAX_AGE_SECONDS=172800
DELIVERY_USAGE_RECONCILIATION_BATCH=100
DELIVERY_WORKER_HEALTH_PATH=/tmp/delivery-worker-health.json
# 1-100 caracteres ASCII: letra/digito inicial; depois letra/digito/._-
# T08-3: DELIVERY_WORKER_CODE_VERSION identifica o build de TODAS as replicas
# (app, delivery-worker, turn-worker); mude a cada deploy. Divergencia entre
# replicas frescas falha readiness e o gate scheduler-state enabled.
DELIVERY_WORKER_CODE_VERSION=outbox-v1
# Cache single-flight dos blocos scheduler/replicas do /health público (5–10s).
HEALTH_OBSERVABILITY_CACHE_SECONDS=5

# Rollout seguro dos webhooks. O comando scripts/provision_provider_auth.sh
# instala/verifica os providers antes de trocar este valor para enforced.
PROVIDER_WEBHOOK_AUTH_MODE=provisioning
PROVIDER_CALLBACK_BASE_URL=http://app:5000
PROVIDER_AUTH_PROBE_BASE_URL=http://app:5000
PROVIDER_AUTH_READINESS_PATH=/app/logs/provider-auth-readiness.json
# Atualizado por `provider_auth_cli check`; o endpoint publico nunca consulta os
# providers diretamente e falha fechado quando este snapshot expira.
PROVIDER_AUTH_READINESS_MAX_AGE_SECONDS=300
PROVIDER_AUTH_READINESS_CACHE_SECONDS=5
# O monitor usa cadencia start-to-start e deadline para a auditoria inteira.
# max(INTERVAL, RETRY_MAX) + AUDIT_TIMEOUT + SHUTDOWN_TIMEOUT < MAX_AGE.
# Falhas usam backoff limitado, sem live probe no endpoint publico.
PROVIDER_AUTH_MONITOR_INTERVAL_SECONDS=120
PROVIDER_AUTH_MONITOR_AUDIT_TIMEOUT_SECONDS=120
PROVIDER_AUTH_MONITOR_RETRY_INITIAL_SECONDS=5
PROVIDER_AUTH_MONITOR_RETRY_MAX_SECONDS=60
PROVIDER_AUTH_MONITOR_SHUTDOWN_TIMEOUT_SECONDS=5

# ─── OPENROUTER (v4.1) ─────────────────────────────────────────────
# Obrigatoria no startup e unica credencial LLM usada pelo app.
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── MYSQL ────────────────────────────────────────────────────────
MYSQL_DATABASE=wpp_bot
MYSQL_USER=wpp_user
MYSQL_PASSWORD=sua-senha-aqui
MYSQL_ROOT_PASSWORD=sua-senha-root-aqui
DATABASE_URL=mysql+aiomysql://wpp_user:sua-senha-aqui@db:3306/wpp_bot

# ─── EVOLUTION API ────────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=sua-evolution-api-key-aqui
# Segredo compartilhado enviado pela Evolution no header Authorization.
# Deixe vazio no primeiro bootstrap; o comando operacional gera e armazena.
EVOLUTION_WEBHOOK_BEARER_TOKEN=
# Chaves separadas do bearer para receipts HMAC. JSON versionado; mantenha
# versões anteriores por pelo menos 90 dias após rotação.
INBOUND_RECEIPT_HMAC_CURRENT_VERSION=1
# Primeiro bootstrap: mantenha `{}`; `provider-auth prepare` grava chave privada.
# Se instalação antiga copiou placeholder público, volte a `{}` somente em
# provisioning/direct e execute prepare. Nunca apague chaves reais já geradas.
INBOUND_RECEIPT_HMAC_KEYS={}

# ─── LOGIN DA API (/auth, /agentes, /sessoes) ─────────────────────
# Pepper de senha versionado, JSON {"versao": "segredo >= 32 caracteres"}.
# `{}` mantém as rotas administrativas fechadas (503). Rotação adiciona versão
# nova e mantém as anteriores até o rehash no login. Nunca versionar valores.
AUTH_PASSWORD_PEPPER_CURRENT_VERSION=1
AUTH_PASSWORD_PEPPER_KEYS={}

# ─── EVOLUTION API — configurações internas ───────────────────────
SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

# Nunca habilite WEBHOOKS em producao: a categoria inclui o payload completo.
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error

DEL_INSTANCE=false

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:postgres@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

CACHE_REDIS_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1030831524

QRCODE_LIMIT=30
QRCODE_COLOR=#175197

AUTHENTICATION_API_KEY=sua-evolution-api-key-aqui
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ─── POSTGRES (Evolution API) ─────────────────────────────────────
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# ─── CHATWOOT ─────────────────────────────────────────────────────
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_ID=
# Deixe vazio no primeiro bootstrap. O Chatwoot gera o secret do webhook de
# conta e o comando operacional o armazena sem imprimi-lo. Nao use SECRET_KEY_BASE.
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300
# Seguro por padrão. Callback público HTTPS não exige acesso a rede privada.
# Troque explicitamente para true somente quando PROVIDER_CALLBACK_BASE_URL usar
# app:5000: isso libera SafeFetch privado globalmente no Chatwoot e pressupõe
# que apenas administradores operacionais confiáveis criem webhooks.
CHATWOOT_SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false


# Release Compose configuration (synthetic placeholders; replace before deployment).
COMPOSE_PROJECT_NAME=wpp-ai-bot-CHANGE-ME
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# No certificates in a fresh checkout; TLS requires explicit configuration.
NGINX_CONF_PATH=./nginx/nginx.dev.conf
CHATWOOT_DB_PASSWORD=replace-chatwoot-db-password
CHATWOOT_SECRET_KEY=replace-chatwoot-secret-key-base
CHATWOOT_FRONTEND_URL=http://chatwoot.localhost
CHATWOOT_MAILER_EMAIL=notifications@example.invalid
SMTP_ADDRESS=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-username
SMTP_PASSWORD=replace-smtp-password
