# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Evolution API Configuration
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_WEBHOOK_BEARER_TOKEN=

# Chatwoot Configuration
CHATWOOT_BASE_URL=http://chatwoot:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_ID=
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300
# Seguro por padrão. Mantenha false com callback HTTPS público. Definir true
# para PROVIDER_CALLBACK_BASE_URL=http://app:5000 libera destinos privados
# globalmente no Chatwoot; somente operadores confiáveis podem administrar
# webhooks nessa instalação.
CHATWOOT_SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false

# Provider webhook authentication rollout
PROVIDER_WEBHOOK_AUTH_MODE=provisioning
PROVIDER_CALLBACK_BASE_URL=http://app:5000
PROVIDER_AUTH_PROBE_BASE_URL=http://app:5000
PROVIDER_AUTH_READINESS_PATH=/app/logs/provider-auth-readiness.json
# Refreshed by the container-only provider_auth_cli check command.
PROVIDER_AUTH_READINESS_MAX_AGE_SECONDS=300
PROVIDER_AUTH_READINESS_CACHE_SECONDS=5
# max(INTERVAL, RETRY_MAX) + AUDIT_TIMEOUT + SHUTDOWN_TIMEOUT < MAX_AGE.
PROVIDER_AUTH_MONITOR_INTERVAL_SECONDS=120
PROVIDER_AUTH_MONITOR_AUDIT_TIMEOUT_SECONDS=120
PROVIDER_AUTH_MONITOR_RETRY_INITIAL_SECONDS=5
PROVIDER_AUTH_MONITOR_RETRY_MAX_SECONDS=60
PROVIDER_AUTH_MONITOR_SHUTDOWN_TIMEOUT_SECONDS=5

# Application Configuration
DATABASE_URL=mysql+aiomysql://wpp_user:your-mysql-password@db:3306/wpp_bot
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=False

# Durable delivery worker (idle until an audited cutover)
DELIVERY_MODE=direct
DELIVERY_DISPATCH_ENABLED=false
DELIVERY_CUTOVER_EPOCH=
# Inbox turn scheduler remains disabled until an explicit audited rollout.
INBOX_SCHEDULER_ENABLED=false
INBOX_SCHEDULER_EPOCH=
# Turn processor stays off. Ticket 06 added handoff and delivery consumers;
# when enabled it still refuses start without the scheduler gate and both epochs.
INBOX_TURN_PROCESSOR_ENABLED=false
INBOX_TURN_PROCESSOR_CONCURRENCY=4
INBOX_TURN_LEASE_SECONDS=30
# Must be finite and shorter than INBOX_TURN_LEASE_SECONDS / 3.
INBOX_TURN_POLL_INTERVAL_SECONDS=0.5
# Every float setting in this block rejects NaN and infinity.
INBOX_GENERATION_TIMEOUT_SECONDS=45
INBOX_TYPING_JITTER_MS=400
INBOX_TURN_RELEASE_BACKOFF_SECONDS=5
INBOX_TURN_WORKER_HEALTH_PATH=/tmp/turn-worker-health.json
DELIVERY_WORKER_CONCURRENCY=8
DELIVERY_CLAIM_MAX_ATTEMPTS=4
# Float settings reject NaN and infinity.
DELIVERY_CLAIM_RETRY_JITTER_SECONDS=0.05
DELIVERY_POLL_INTERVAL_SECONDS=1
DELIVERY_LEASE_RENEW_INTERVAL_SECONDS=30
DELIVERY_EVOLUTION_LEASE_SECONDS=90
DELIVERY_CHATWOOT_LEASE_SECONDS=120
DELIVERY_EVOLUTION_DEADLINE_SECONDS=60
DELIVERY_CHATWOOT_DEADLINE_SECONDS=300
DELIVERY_TRANSITION_TTL_SECONDS=1800
DELIVERY_AUTOMATED_TTL_SECONDS=1800
DELIVERY_HUMAN_REPLY_TTL_SECONDS=86400
DELIVERY_HANDOFF_SETUP_TTL_SECONDS=86400
DELIVERY_SHUTDOWN_GRACE_SECONDS=30
DELIVERY_SHUTDOWN_ABORT_SECONDS=5
DELIVERY_HEARTBEAT_INTERVAL_SECONDS=15
DELIVERY_READINESS_INTERVAL_SECONDS=60
DELIVERY_MAINTENANCE_INTERVAL_SECONDS=15
DELIVERY_MAINTENANCE_SKIP_ERROR_THRESHOLD=3
DELIVERY_RETENTION_INTERVAL_SECONDS=3600
DELIVERY_USAGE_RECONCILIATION_BATCH=100
DELIVERY_WORKER_HEALTH_PATH=/tmp/delivery-worker-health.json
# 1-100 safe ASCII chars: alphanumeric first, then alphanumeric/._-
# T08-3: DELIVERY_WORKER_CODE_VERSION identifica o build de TODAS as replicas
# (app, delivery-worker, turn-worker); mude a cada deploy. Divergencia entre
# replicas frescas falha readiness e o gate scheduler-state enabled.
DELIVERY_WORKER_CODE_VERSION=outbox-v1
# Public /health scheduler/replica single-flight cache (finite, 5-10 seconds).
HEALTH_OBSERVABILITY_CACHE_SECONDS=5

# Versioned receipt HMAC keys. Keep retired keys for the 90-day receipt
# retention horizon; never reuse the Evolution bearer as an HMAC key.
INBOUND_RECEIPT_HMAC_CURRENT_VERSION=1
# First bootstrap: keep `{}`; provider-auth prepare writes a private key. If a
# legacy copy contains a public placeholder, reset it to `{}` only while in
# provisioning/direct, then rerun prepare. Never remove real retained keys.
INBOUND_RECEIPT_HMAC_KEYS={}

# S1: scheduler retention budgets and SLA tolerance (seconds)
SCHEDULER_RETENTION_MAX_ROWS=10000
SCHEDULER_RETENTION_MAX_SECONDS=30
SCHEDULER_RETENTION_SLA_TOLERANCE_SECONDS=86400
# FU-1: finite margin; interval*N > budget+margin; sweep age+tolerance <7d.
DELIVERY_RETENTION_OVERRUN_MARGIN_SECONDS=30
DELIVERY_RETENTION_COMPLETION_MAX_INTERVALS=2
SCHEDULER_RETENTION_SWEEP_MAX_AGE_SECONDS=172800


# Release Compose configuration (synthetic placeholders; replace before deployment).
COMPOSE_PROJECT_NAME=wpp-ai-bot-CHANGE-ME
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# No certificates in a fresh checkout; TLS requires explicit configuration.
NGINX_CONF_PATH=./nginx/nginx.dev.conf
CHATWOOT_DB_PASSWORD=replace-chatwoot-db-password
CHATWOOT_SECRET_KEY=replace-chatwoot-secret-key-base
CHATWOOT_FRONTEND_URL=http://chatwoot.localhost
CHATWOOT_MAILER_EMAIL=notifications@example.invalid
SMTP_ADDRESS=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=replace-smtp-username
SMTP_PASSWORD=replace-smtp-password
MYSQL_DATABASE=wpp_bot
MYSQL_USER=wpp_user
MYSQL_PASSWORD=replace-mysql-password
MYSQL_ROOT_PASSWORD=replace-mysql-root-password
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace-postgres-password
EVOLUTION_LOG_LEVEL=ERROR,WARN,INFO
